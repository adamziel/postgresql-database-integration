<phpunit
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
		bootstrap="tests/bootstrap-postgresql.php"
		backupGlobals="false"
		colors="true"
		beStrictAboutTestsThatDoNotTestAnything="true"
		beStrictAboutOutputDuringTests="true"
		cacheDirectory=".phpunit.cache"
		>
	<php>
		<ini name="memory_limit" value="512M"/>
	</php>
	<testsuites>
		<testsuite name="postgresql">
			<file>tests/WP_PostgreSQL_Connection_Tests.php</file>
			<file>tests/WP_PostgreSQL_Create_Table_Translator_Tests.php</file>
			<file>tests/WP_PostgreSQL_DB_Tests.php</file>
			<file>tests/WP_PostgreSQL_Driver_RegExp_Tests.php</file>
			<file>tests/WP_PostgreSQL_Driver_Tests.php</file>
			<file>tests/WP_PostgreSQL_Install_Functions_Tests.php</file>
		</testsuite>
	</testsuites>
</phpunit>
