<?php
/**
 * Plugin Name: WordPress Databases Support (Drop-in)
 * Version: 0.1.0
 * Author: The WordPress Team
 *
 * Copy this file to wp-content/db.php to load the configured database
 * integration before WordPress creates the wpdb instance.
 *
 * @package wordpress-databases-support
 */

define( 'WORDPRESS_DATABASES_SUPPORT_DB_DROPIN_VERSION', '0.1.0' );

$databases_support_plugin_implementation_folder_path = '{WORDPRESS_DATABASES_SUPPORT_IMPLEMENTATION_FOLDER_PATH}';
if ( ! file_exists( $databases_support_plugin_implementation_folder_path ) ) {
	$databases_support_plugin_implementation_folder_path = realpath( __DIR__ . '/plugins/wordpress-databases-support' );
}

if (
	! $databases_support_plugin_implementation_folder_path
	|| ! file_exists( $databases_support_plugin_implementation_folder_path . '/wp-includes/db.php' )
) {
	return;
}

$database_engine = defined( 'DB_ENGINE' )
	? strtolower( (string) DB_ENGINE )
	: ( defined( 'DATABASE_ENGINE' ) ? DATABASE_ENGINE : 'postgresql' );
$database_engine = strtolower( (string) $database_engine );
if ( in_array( $database_engine, array( 'postgres', 'pgsql', 'postgresql' ), true ) ) {
	$database_engine = 'postgresql';
} elseif ( in_array( $database_engine, array( 'duck', 'duckdb' ), true ) ) {
	$database_engine = 'duckdb';
} elseif ( in_array( $database_engine, array( 'sqlite', 'sqlite3' ), true ) ) {
	$database_engine = 'sqlite';
}

if ( ! defined( 'DATABASE_TYPE' ) ) {
	define( 'DATABASE_TYPE', $database_engine );
}

if ( ! defined( 'DB_ENGINE' ) ) {
	define( 'DB_ENGINE', $database_engine );
}

require_once $databases_support_plugin_implementation_folder_path . '/wp-includes/db.php';
